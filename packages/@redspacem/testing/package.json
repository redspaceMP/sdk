{
  "name": "@redspacem/testing",
  "version": "0.1.2",
  "description": "Testing helpers for RedSpace resources: createMockMp for a mock mp.* host and createMemoryTransport for in-memory RPC.",
  "license": "MIT",
  "author": "RedSpace contributors",
  "type": "module",
  "keywords": [
    "RedSpace",
    "cyberpunk-2077",
    "multiplayer",
    "testing",
    "mock",
    "rpc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redspaceMP/sdk.git",
    "directory": "packages/@redspacem/testing"
  },
  "homepage": "https://www.npmjs.com/package/@redspacem/testing",
  "bugs": {
    "url": "https://github.com/redspaceMP/sdk/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@redspacem/rpc": "^0.1.2",
    "@redspacem/server-types": "^0.1.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  }
}
