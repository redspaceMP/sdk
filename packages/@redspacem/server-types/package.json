{
  "name": "@redspacem/server-types",
  "version": "0.1.0",
  "description": "Typed contract for the mp.* scripting host API injected by the RedSpaceM server core (Mp, MpPlayer, MpVector3, MpVehicle, events, commands).",
  "license": "MIT",
  "author": "RedSpaceM contributors",
  "type": "module",
  "keywords": [
    "redspacem",
    "cyberpunk-2077",
    "multiplayer",
    "gamemode",
    "scripting",
    "mp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waveluv/redspacem.git"
  },
  "homepage": "https://github.com/waveluv/redspacem#readme",
  "bugs": {
    "url": "https://github.com/waveluv/redspacem/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
