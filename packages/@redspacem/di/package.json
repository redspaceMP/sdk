{
  "name": "@redspacem/di",
  "version": "0.1.2",
  "description": "A tiny dependency-injection container for RedSpace resources: register, registerValue, resolve and has with lazy singletons.",
  "license": "MIT",
  "author": "RedSpace contributors",
  "type": "module",
  "keywords": [
    "RedSpace",
    "cyberpunk-2077",
    "multiplayer",
    "di",
    "dependency-injection",
    "container"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redspaceMP/sdk.git",
    "directory": "packages/@redspacem/di"
  },
  "homepage": "https://www.npmjs.com/package/@redspacem/di",
  "bugs": {
    "url": "https://github.com/redspaceMP/sdk/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  }
}
