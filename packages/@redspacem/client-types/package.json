{
  "name": "@redspacem/client-types",
  "version": "0.1.1",
  "description": "Typed contract for the client-side scripting API injected by the RedSpaceM client plugin (ClientMp, camera, input, render, event bus) plus a lerp helper.",
  "license": "MIT",
  "author": "RedSpaceM contributors",
  "type": "module",
  "keywords": [
    "redspacem",
    "cyberpunk-2077",
    "multiplayer",
    "client",
    "scripting"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redspaceMP/sdk.git"
  },
  "homepage": "https://github.com/redspaceMP/sdk#readme",
  "bugs": {
    "url": "https://github.com/redspaceMP/sdk/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@redspacem/server-types": "^0.1.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
