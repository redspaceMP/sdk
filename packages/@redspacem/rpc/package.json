{
  "name": "@redspacem/rpc",
  "version": "0.1.2",
  "description": "Dependency-free, type-safe RPC layer for RedSpaceM resources: RpcServer, RpcClient, TypedRpc and a JSON transport contract.",
  "license": "MIT",
  "author": "RedSpaceM contributors",
  "type": "module",
  "keywords": [
    "redspacem",
    "cyberpunk-2077",
    "multiplayer",
    "rpc",
    "typesafe"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redspaceMP/sdk.git",
    "directory": "packages/@redspacem/rpc"
  },
  "homepage": "https://www.npmjs.com/package/@redspacem/rpc",
  "bugs": {
    "url": "https://github.com/redspaceMP/sdk/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  }
}
