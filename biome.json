{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!site/node_modules",
      "!site/.vocs",
      "!site/.cache",
      "!site/src/pages.gen.ts",
      "!site/public/search-index.json",
      "!site/public/search-index.min.json",
      "!**/dist",
      "!resources/freeroam/server/dist",
      "!tools/rsm-cli",
      "!target",
      "!.git"
    ]
  },
  "formatter": {
    "lineWidth": 100,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "quoteStyle": "double"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "off"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  }
}
